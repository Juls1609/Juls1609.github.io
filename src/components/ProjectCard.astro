---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const projectUrl = `${import.meta.env.BASE_URL}projects/${project.slug}/`;
const cardImage = project.cardImage ?? project.image;
---

<article class="project-card">
  <div class="project-visual" aria-hidden="true">
    {cardImage ? (
      <img src={`${import.meta.env.BASE_URL}${cardImage}`} alt="" loading="lazy" />
    ) : (
      <><div class="pitch-lines"></div><div class="project-ball"></div></>
    )}
  </div>
  <div class="project-copy">
    <p class="eyebrow">{project.eyebrow} · {project.year}</p>
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    <ul class="tag-list" aria-label="Technologies">
      {project.technologies.slice(0, 4).map((technology) => <li>{technology}</li>)}
    </ul>
    <div class="card-actions"><a class="text-link" href={projectUrl}>Explore project <span aria-hidden="true">↗</span></a>{project.demo && <a class="text-link text-link-muted" href={project.demo.url} target="_blank" rel="noreferrer">{project.demo.label} ↗</a>}</div>
  </div>
</article>
