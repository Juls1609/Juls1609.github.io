---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Share image path relative to `public/`; defaults to the profile photo. */
  image?: string;
}

const { title, description, image = 'images/julieta-schwartz-cerveny.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
// Social networks need an absolute image address.
const shareImage = new URL(`${import.meta.env.BASE_URL}${image}`, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1326" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
